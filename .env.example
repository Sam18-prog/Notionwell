# ==============================================================================
# NOTIONWELL 2.0 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and replace placeholders with your real credentials.
# NEVER commit .env.local or expose production secret keys to version control.

# ------------------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE (Backend Database, Auth, Storage)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Project Anonymous Public Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Your Supabase Service Role Key (PRIVILEGED SERVER-ONLY — NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. AI MODEL PROVIDER OPTIONS (Choose at least one)
# ------------------------------------------------------------------------------
# Option A: Google Gemini API (Recommended for speed and multimodal vision OCR)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Option C: Groq Cloud API (Super-fast Llama 3.3 70B inference)
GROQ_API_KEY=your_groq_api_key_here

# Option D: OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Active Model Override (Optional — defaults to provider's recommended fast model)
# Examples: gemini-2.5-flash, gemini-flash-latest, llama-3.3-70b-versatile, gpt-4o-mini
AI_MODEL=gemini-2.5-flash

# Custom Local LLM / Ollama Endpoint (Optional)
# AI_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://notionwell.vercel.app
